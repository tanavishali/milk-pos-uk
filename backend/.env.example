# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.

NODE_ENV=development
PORT=3001

# MongoDB Atlas (a replica set, which is what makes transactions available) or
# a local server: mongodb://127.0.0.1:27017/blanksys_pos
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# Access-token signing key. Minimum 32 characters, enforced at boot.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h

# ---------------------------------------------------------------------------
# Everything below is optional. The defaults shown are what the app uses when
# the variable is absent; an unparseable value stops the boot rather than
# silently falling back.
# ---------------------------------------------------------------------------

# General rate limit: requests allowed per window, per caller.
#RATE_LIMIT_TTL_MS=60000
#RATE_LIMIT_COUNT=300

# Sign-in attempts. Deliberately far stricter: this is the endpoint a password
# list is worked through.
#AUTH_RATE_LIMIT_TTL_MS=900000
#AUTH_RATE_LIMIT_COUNT=10

# Reverse proxies in front of this process. 0 is a direct connection; set it to
# the real hop count on a platform that terminates TLS for you (Render, Fly,
# nginx). Too low and every caller shares one allowance; too high and a caller
# can forge X-Forwarded-For to get a fresh one per request.
#TRUST_PROXY_HOPS=0

# Largest accepted request body.
#BODY_LIMIT=256kb

# Page size for list endpoints. `PAGE_MAX_LIMIT` is a ceiling `?limit=` cannot
# raise.
#PAGE_DEFAULT_LIMIT=50
#PAGE_MAX_LIMIT=200
